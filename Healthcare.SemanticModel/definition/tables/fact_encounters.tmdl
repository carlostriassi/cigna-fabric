/// One row per clinical encounter (INPATIENT, OUTPATIENT, EMERGENCY, TELEHEALTH). Grain: encounter_id. Primary date: admit_date — default time axis for utilization and episode-based analysis.
table fact_encounters
	lineageTag: 85edf9e7-c27b-4706-aa96-30af1b83d855
	sourceLineageTag: [healthcare].[fact_encounters]

	/// Internal anchor: latest date with encounter data. Drives all encounter YTD/MTD/LY/3M measures. Do not display in visuals.
	measure 'Last Encounters Date' =
			LASTNONBLANK (
			'dim_date'[full_date],
			CALCULATE ( COUNTROWS ( fact_encounters ) )
			)
		lineageTag: d7cdef31-2162-418c-8545-3a1043980c8d

	/// Count of encounter rows in filter context. Not a distinct patient count — one patient can have multiple encounters across visits.
	measure 'Total Encounters' = COUNTROWS ( fact_encounters )
		lineageTag: b494e010-738e-46a9-8ec1-f3160364463b

	/// Encounter count from Jan 1 of the most recent data year through the last encounter date. For Cigna fiscal YTD (starts June) filter dim_date[fiscal_year] directly.
	measure 'Encounters YTD' =
			VAR _refDate = [Last Encounters Date]
			RETURN
			CALCULATE (
			[Total Encounters],
			DATESBETWEEN (
			'dim_date'[full_date],
			DATE ( YEAR ( _refDate ), 1, 1 ),
			_refDate
			)
			)
		lineageTag: d4a7e34c-19f6-4a13-a9fa-283c95d77f18

	/// Encounter count from the 1st of the current month through the last encounter date. Use for month-to-date utilization monitoring.
	measure 'Encounters MTD' =
			VAR _refDate = [Last Encounters Date]
			RETURN
			CALCULATE (
			[Total Encounters],
			DATESBETWEEN (
			'dim_date'[full_date],
			EOMONTH ( _refDate, -1 ) + 1,
			_refDate
			)
			)
		lineageTag: c60aab6b-6626-4f87-9464-9e5d30e560f3

	/// Encounter count for the equivalent YTD window in the prior calendar year. Use as baseline in YoY comparisons.
	measure 'Total Encounters LY' =
			VAR _refDate = [Last Encounters Date]
			RETURN
			CALCULATE (
			[Total Encounters],
			DATESBETWEEN (
			'dim_date'[full_date],
			DATE ( YEAR ( _refDate ) - 1, 1, 1 ),
			EDATE ( _refDate, -12 )
			)
			)
		lineageTag: b0773420-51f3-44db-8d16-0f4f022034ae

	/// Year-over-year % change in encounter volume. Positive = more encounters vs prior year. Do not sum — ratio measure. Returns BLANK if no prior-year data.
	measure 'Encounters YoY %' =
			DIVIDE (
			[Total Encounters] - [Total Encounters LY],
			[Total Encounters LY],
			BLANK ()
			)
		lineageTag: efce56a9-b101-4bec-bb06-7b5e04624cc0

	/// Sum of gross billed charges (total_charges) across encounters in context (USD). Finance = gross billed; not allowed (contracting) or paid (net of cost-share) amount.
	measure 'Total Total Charges' = SUM ( fact_encounters[total_charges] )
		lineageTag: 2c5e77ae-1c9b-4513-9953-53e15b7cc18f

	/// Average gross billed charge per encounter (USD). Use for cost benchmarking by encounter_type, facility_code, or provider specialty.
	measure 'Avg Total Charges' = AVERAGE ( fact_encounters[total_charges] )
		lineageTag: c6455548-6531-4a62-b2fa-9050fe202af6

	/// Sum of encounter gross billed charges from Jan 1 of the most recent data year through last encounter date (USD). For Cigna FY use dim_date[fiscal_year] filter.
	measure 'Total Charges YTD' =
			VAR _refDate = [Last Encounters Date]
			RETURN
			CALCULATE (
			[Total Total Charges],
			DATESBETWEEN (
			'dim_date'[full_date],
			DATE ( YEAR ( _refDate ), 1, 1 ),
			_refDate
			)
			)
		lineageTag: 3ed42bd2-5300-474b-8bc4-47c972d76053

	/// Sum of encounter gross billed charges for the equivalent YTD window in the prior calendar year (USD). Use as financial baseline for YoY charge comparisons.
	measure 'Total Total Charges LY' =
			VAR _refDate = [Last Encounters Date]
			RETURN
			CALCULATE (
			[Total Total Charges],
			DATESBETWEEN (
			'dim_date'[full_date],
			DATE ( YEAR ( _refDate ) - 1, 1, 1 ),
			EDATE ( _refDate, -12 )
			)
			)
		lineageTag: 7ef63d98-7f7b-4284-9e8a-3e9b8c712482

	/// Year-over-year % change in total encounter charges. Positive = higher charges vs prior year. Do not sum — ratio measure. Rising charges may reflect volume growth or unit-cost inflation.
	measure 'Total Charges YoY %' =
			DIVIDE (
			[Total Total Charges] - [Total Total Charges LY],
			[Total Total Charges LY],
			BLANK ()
			)
		lineageTag: 0c710621-87b8-4136-a6ae-e46c112bb6ad

	/// Sum of encounter charges over the trailing 3 calendar months ending on the last encounter date (USD). Use as a smoothed trend line to reduce month-to-month volatility.
	measure 'Total Charges 3M Rolling' =
			VAR _refDate = [Last Encounters Date]
			RETURN
			CALCULATE (
			[Total Total Charges],
			DATESINPERIOD (
			'dim_date'[full_date],
			_refDate,
			-3,
			MONTH
			)
			)
		lineageTag: 4dbd1be6-21ea-4359-85aa-2de948f60363

	/// Row surrogate key. Identifier — do not sum. Internal pipeline field for row uniqueness.
	column fact_encounter_sk
		dataType: int64
		formatString: 0
		lineageTag: 149158c1-40ba-4ac9-bc7c-92d3724fe11f
		sourceLineageTag: fact_encounter_sk
		summarizeBy: none
		sourceColumn: fact_encounter_sk

		annotation SummarizationSetBy = Automatic

	/// YYYYMMDD integer FK to dim_date. Derived from admit_date — the primary episode date for utilization and clinical analysis. Identifier — do not sum.
	column date_key
		dataType: int64
		formatString: 0
		lineageTag: 7e083617-c28a-496d-86a7-cdf080cb9b99
		sourceLineageTag: date_key
		summarizeBy: none
		sourceColumn: date_key

		annotation SummarizationSetBy = Automatic

	/// FK to dim_patient (SCD2 — version at time of admission). Identifier — do not sum. Links encounter to patient demographics as they were at admit_date.
	column patient_sk
		dataType: int64
		formatString: 0
		lineageTag: 80a68b39-d97c-4499-9593-bbe1a48528aa
		sourceLineageTag: patient_sk
		summarizeBy: none
		sourceColumn: patient_sk

		annotation SummarizationSetBy = Automatic

	/// FK to dim_provider. Identifier — do not sum. Drives RLS filtering — all four role types restrict encounter visibility via this join.
	column provider_sk
		dataType: int64
		formatString: 0
		lineageTag: 441f7955-acc8-4e7c-9817-1ab8c1162492
		sourceLineageTag: provider_sk
		summarizeBy: none
		sourceColumn: provider_sk

		annotation SummarizationSetBy = Automatic

	/// Source system natural key for the encounter. Identifier — do not sum. One patient can have multiple encounter_id rows across visits.
	column encounter_id
		dataType: int64
		formatString: 0
		lineageTag: 20991f02-b564-4c94-ab6b-460bfc515a46
		sourceLineageTag: encounter_id
		summarizeBy: none
		sourceColumn: encounter_id

		annotation SummarizationSetBy = Automatic

	/// Human-readable encounter reference (format: ENC-XXXXXX). Identifier — do not sum. Use for encounter lookups and drill-through labels.
	column encounter_code
		dataType: string
		lineageTag: 2e4e6e64-7a95-4674-a27a-47107ae922df
		sourceLineageTag: encounter_code
		summarizeBy: none
		sourceColumn: encounter_code

		annotation SummarizationSetBy = Automatic

	/// Date the encounter began (admission or visit start). Primary time axis for episode-based and utilization analysis. Distinct from procedure_date and scheduled_at.
	column admit_date
		dataType: dateTime
		formatString: General Date
		lineageTag: c1f1d71c-8518-4cc0-88b9-4252c002cae9
		sourceLineageTag: admit_date
		summarizeBy: none
		sourceColumn: admit_date

		annotation SummarizationSetBy = Automatic

	/// Date the patient was discharged. Use with admit_date to compute length of stay. DQ enforces discharge_date >= admit_date.
	column discharge_date
		dataType: dateTime
		formatString: General Date
		lineageTag: ad9b3320-987e-46f8-b730-77469b5eb6c0
		sourceLineageTag: discharge_date
		summarizeBy: none
		sourceColumn: discharge_date

		annotation SummarizationSetBy = Automatic

	/// Care setting: EMERGENCY, INPATIENT, OUTPATIENT, TELEHEALTH. Primary dimension for utilization-mix analysis and capacity planning.
	column encounter_type
		dataType: string
		lineageTag: 5ba3fc9d-15c7-49cf-838a-4a6e3a854c7a
		sourceLineageTag: encounter_type
		summarizeBy: none
		sourceColumn: encounter_type

		annotation SummarizationSetBy = Automatic

	/// How the patient entered the encounter: WALK_IN, PHYSICIAN_REFERRAL, EMERGENCY_ROOM, TRANSFER, SELF_REFERRAL. Use for referral-pattern and access-channel analysis.
	column admission_source
		dataType: string
		lineageTag: e593b9ed-dd3f-4e8d-9003-79c2086585fc
		sourceLineageTag: admission_source
		summarizeBy: none
		sourceColumn: admission_source

		annotation SummarizationSetBy = Automatic

	/// Post-discharge destination: HOME, TRANSFER, SKILLED_NURSING, EXPIRED, AMA, ABANDONED. Use for post-acute care utilization and outcomes analysis.
	column discharge_disposition
		dataType: string
		lineageTag: 717c7653-0255-46af-b2e9-033772de9722
		sourceLineageTag: discharge_disposition
		summarizeBy: none
		sourceColumn: discharge_disposition

		annotation SummarizationSetBy = Automatic

	/// FK to a prior appointment that led to this encounter. Nullable — 34.7% NULL (expected for walk-in and ED encounters). Identifier — do not sum.
	column appointment_id
		dataType: int64
		formatString: 0
		lineageTag: ef6ef473-cf81-499e-bf55-95bfde3768eb
		sourceLineageTag: appointment_id
		summarizeBy: none
		sourceColumn: appointment_id

		annotation SummarizationSetBy = Automatic

	/// Facility where the encounter occurred (FAC-MAIN, FAC-NORTH, FAC-SOUTH, FAC-EAST, FAC-WEST). Degenerate dimension — no separate facility table. Use for facility-level breakdowns.
	column facility_code
		dataType: string
		lineageTag: 82c7024d-69c3-492b-84a7-d921364b1b86
		sourceLineageTag: facility_code
		summarizeBy: none
		sourceColumn: facility_code

		annotation SummarizationSetBy = Automatic

	/// Inpatient stay duration in days. Additive — use AVERAGE for benchmarking, SUM for total bed-days. Negative values rejected by DQ. Relevant only for INPATIENT encounter_type.
	column length_of_stay_days
		dataType: int64
		formatString: 0
		lineageTag: 5c1b89e2-92e8-4221-9093-bfe1076a9856
		sourceLineageTag: length_of_stay_days
		summarizeBy: sum
		sourceColumn: length_of_stay_days

		annotation SummarizationSetBy = Automatic

	/// Gross billed charges for the encounter (USD). Additive. Finance definition: gross billed. Not allowed amount (contracting) or paid amount (net of cost-share). See contentious metric note.
	column total_charges
		dataType: decimal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: f1eca78b-9ec5-4414-9bc2-4f4425b89c84
		sourceLineageTag: total_charges
		summarizeBy: sum
		sourceColumn: total_charges

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	partition fact_encounters = entity
		mode: directLake
		source
			entityName: fact_encounters
			schemaName: healthcare
			expressionSource: 'DirectLake - GoldLH'

