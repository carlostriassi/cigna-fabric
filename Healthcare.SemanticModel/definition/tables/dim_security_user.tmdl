/// Internal RLS lookup table — not for report use. OLS blocks access for all roles. Powers LOOKUPVALUE() in role filterExpressions to scope rows by provider_id or region_code.
table dim_security_user
	lineageTag: ac5ab9d4-953c-479d-a851-e4f2a9150d2e
	sourceLineageTag: [shared].[dim_security_user]

	/// Entra ID UPN of the signed-in user (lowercase). Used internally by LOOKUPVALUE() in RLS filterExpressions. Not for report display.
	column user_principal_name
		dataType: string
		lineageTag: 0bda4473-1d25-4f42-8d5d-8bac787bb9b3
		sourceLineageTag: user_principal_name
		summarizeBy: none
		sourceColumn: user_principal_name

		annotation SummarizationSetBy = Automatic

	/// Human-readable name of the security user. Internal field — not for report display.
	column display_name
		dataType: string
		lineageTag: f4203635-792d-44bc-b2fb-be50b6392d65
		sourceLineageTag: display_name
		summarizeBy: none
		sourceColumn: display_name

		annotation SummarizationSetBy = Automatic

	/// Data domain this user record applies to (e.g. healthcare). Internal field used to scope RLS lookups to the correct domain.
	column domain
		dataType: string
		lineageTag: f587f3e8-964f-4f3d-ba05-807c9b30e8d0
		sourceLineageTag: domain
		summarizeBy: none
		sourceColumn: domain

		annotation SummarizationSetBy = Automatic

	/// Security role assigned to this user (healthcare_provider, regional_manager, etc.). Internal field — drives RLS scoping via role membership.
	column role
		dataType: string
		lineageTag: 96d0a616-17e8-47be-b7ae-452a63956041
		sourceLineageTag: role
		summarizeBy: none
		sourceColumn: role

		annotation SummarizationSetBy = Automatic

	/// Provider ID attribute for RLS scoping. Populated only for healthcare_provider role users. Internal — not for report display.
	column provider_id
		dataType: string
		lineageTag: 0d3eff10-09bb-47c7-aed6-ec38e037d748
		sourceLineageTag: provider_id
		summarizeBy: none
		sourceColumn: provider_id

		annotation SummarizationSetBy = Automatic

	/// Region code attribute for RLS scoping. Populated only for regional_manager role users. Internal — not for report display.
	column region_code
		dataType: string
		lineageTag: 69347952-a0c7-40ac-a2c2-3a4a70e95f80
		sourceLineageTag: region_code
		summarizeBy: none
		sourceColumn: region_code

		annotation SummarizationSetBy = Automatic

	/// Soft-delete flag. Only active=true users are returned by LOOKUPVALUE() in RLS predicates. Internal field.
	column is_active
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: dcb77cb8-17df-403f-8484-f20f36d10a06
		sourceLineageTag: is_active
		summarizeBy: none
		sourceColumn: is_active

		annotation SummarizationSetBy = Automatic

	/// Surrogate key. Identifier — do not sum. Internal pipeline field, not for report use.
	column user_sk
		dataType: int64
		formatString: 0
		lineageTag: a6d451c0-547b-423e-9e20-425fa1eed93f
		sourceLineageTag: user_sk
		summarizeBy: sum
		sourceColumn: user_sk

		annotation SummarizationSetBy = Automatic

	/// Timestamp when this security user record was created. Internal audit field — not for report display.
	column _created_at
		dataType: dateTime
		formatString: General Date
		lineageTag: ee7e6698-1c8a-40cd-9609-beafaa29511f
		sourceLineageTag: _created_at
